{
  extends: [
    "config:recommended",
  ],
  dependencyDashboard: true,
  minimumReleaseAge: "7 days",
  postUpdateOptions: ["gomodTidy"],
  "pre-commit": {
    enabled: true,
  },
  kubernetes: {
    managerFilePatterns: ["/^\\.github/(actions/garage/garage|registry)\\.yaml$/"],
  },
  customManagers: [
    {
      // container images of the jobs created by the plugin
      customType: "regex",
      managerFilePatterns: ["/\\.go$/"],
      matchStrings: [
        "\"(?<depName>[a-z0-9.-]+(?:/[a-z0-9._-]+)+):(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\"",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^(docs/|\\.web-docs/)?README\\.md$/"],
      matchStrings: ["FROM hashicorp/packer:(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "hashicorp/packer",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/actions/cluster/action\\.yml$/"],
      matchStrings: [
        "github\\.com/(?<depName>kubevirt/common-instancetypes)/[^?\\s]+\\?ref=(?<currentValue>v[0-9.]+)",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^mise\\.toml$/"],
      matchStrings: ["CDI_VERSION = \"(?<currentValue>v[0-9.]+)\""],
      depNameTemplate: "kubevirt/containerized-data-importer",
      datasourceTemplate: "github-releases",
    },
  ],
  packageRules: [
    {
      // pinned by a replace directive to the version k8s.io/apimachinery requires
      matchDatasources: ["go"],
      matchPackageNames: ["k8s.io/kube-openapi"],
      enabled: false,
    },
    {
      // the client libraries and the KubeVirt of the tests, from mise.toml
      groupName: "kubevirt",
      matchPackageNames: ["kubevirt.io/api", "kubevirt.io/client-go", "kubevirt/kubevirt"],
    },
    {
      // the CDI of the tests and the importer image of the jobs
      groupName: "cdi",
      matchPackageNames: ["kubevirt/containerized-data-importer", "quay.io/kubevirt/cdi-importer"],
    },
  ],
}
